# Prevent script execution and directory listing
<IfModule mod_php7.c>
    <FilesMatch "\.(php|php5|phtml)$">
        Deny from all
    </FilesMatch>
</IfModule>
<IfModule mod_php.c>
    <FilesMatch "\.(php|php5|phtml)$">
        Deny from all
    </FilesMatch>
</IfModule>
# For Apache 2.4+
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|php5|phtml|pl|py|jsp|asp|aspx)$">
        Require all denied
    </FilesMatch>
</IfModule>
Options -Indexes
